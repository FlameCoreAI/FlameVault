# FlameVault n8n Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# n8n Configuration
# ============================================================================

# n8n Host and Protocol
N8N_HOST=localhost
N8N_PROTOCOL=https
N8N_PORT=5678

# n8n Encryption Key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# n8n Basic Auth (for UI access)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Logging Level (debug, info, warn, error)
N8N_LOG_LEVEL=info

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ============================================================================
# Redis Configuration (Queue and State)
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Webhook Security
# ============================================================================

# Webhook HMAC Secret (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=

# ============================================================================
# AI Brain Integration
# ============================================================================

AI_BRAIN_URL=https://ai-brain.example.com
AI_BRAIN_API_KEY=

# ============================================================================
# Ollama Integration (Optional)
# ============================================================================

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# ============================================================================
# FlameVault Integration
# ============================================================================

FLAMEVAULT_API_URL=https://api.flamevault.com
FLAMEVAULT_API_KEY=

# ============================================================================
# Monitoring and Alerts
# ============================================================================

# Slack Webhook for Alerts
SLACK_WEBHOOK_URL=

# Prometheus Push Gateway (Optional)
PROMETHEUS_PUSHGATEWAY=http://prometheus-pushgateway:9091

# ============================================================================
# Additional Service Configuration
# ============================================================================

# Timezone
TZ=UTC

# ============================================================================
# Security Notes
# ============================================================================
# 1. Generate strong passwords for all services
# 2. Use unique keys for encryption and webhooks
# 3. Store credentials in a secure vault in production
# 4. Rotate credentials regularly
# 5. Never commit this file with actual values

# ============================================================================
# Generating Secure Values
# ============================================================================
# 
# Generate random hex string (32 bytes):
#   openssl rand -hex 32
#
# Generate random base64 string:
#   openssl rand -base64 32
#
# Generate UUID:
#   uuidgen
